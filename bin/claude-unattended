#!/usr/bin/env bash
set -euo pipefail

stage=$(mktemp -d /tmp/claude-srt-unattended.XXXXX)
cp -rL ~/.claude/. "$stage/"
cp -L ~/.claude.json "$stage/.claude.json" 2>/dev/null || true
export CLAUDE_CONFIG_DIR="$stage"

tmp_srt=$(mktemp -d /tmp/srt-unattended.XXXXX)
export TMPDIR="$tmp_srt"

export GITHUB_TOKEN=$(gh auth token)

exec @SRT@ --settings "@AGENTSDIR@/srt-settings.json" -- claude \
  --settings "$stage/settings.unattended.json" \
  --strict-mcp-config \
  --mcp-config "$stage/default.mcp.json" \
  --permission-mode auto \
  "$@"

{
  "mcpServers": {
    "context7": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@upstash/context7-mcp"
      ],
      "headersHelper": "printf '{\"Authorization\":\"Bearer %s\"}' \"$(sops exec-env ~/.config/utilities/sops/claude-code.env \"printenv CONTEXT7_API_KEY\")\""
    },
    "github": {
      "type": "http",
      "url": "https://api.githubcopilot.com/mcp",
      "headersHelper": "printf '{\"Authorization\":\"Bearer %s\"}' \"$(gh auth token)\""
    }
  }
}

#!/usr/bin/env bash
set -euo pipefail

usage() {
  echo "a simple agentic coding setup."
  echo
  echo "Commands:"
  echo "  claude"
}

cmd_claude() {
  local argv=(--mcp-config "@CLAUDEDIR@/default.mcp.json")
  case "${1:-}" in
  --agents-unattended)
    shift
    argv+=(--settings "@CLAUDEDIR@/settings.unattended.json")
    ;;
  esac
  exec claude "${argv[@]}" "$@"
}

case "${1:-}" in
claude)
  shift
  cmd_claude "$@"
  ;;
*)
  usage >&2
  exit 1
  ;;
esac

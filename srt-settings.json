{
  "network": {
    "allowedDomains": [
      "*.anthropic.com",
      "*.claude.com",
      "*.githubcopilot.com",
      "*.github.com",
      "*.githubusercontent.com",
      "*.sscdn.co",
      "registry.npmjs.org",
      "stackoverflow.com",
      "go.dev",
      "*.golang.org",
      "github.com",
      "mcp.context7.com",
      "mcp.figma.com",
      "direnv.net",
      "www.gnu.org",
      "just.systems",
      "taskfile.dev",
      "docs.deno.com",
      "www.nushell.sh",
      "doc.rust-lang.org",
      "docs.rs",
      "elv.sh",
      "pkg.go.dev",
      "toml.io"
    ],
    "deniedDomains": []
  },
  "filesystem": {
    "denyRead": [
      "/etc",
      "/boot",
      "/run",
      "/sys",
      "/home",
      "/proc",
      "/tmp/utilities-cryptsetup.*",
      "**/.edgerc",
      "**/.env*"
    ],
    "allowRead": [
      "/etc/ssl",
      "/etc/ca-certificates",
      "/etc/pki",
      "/etc/hosts",
      "/etc/resolv.conf",
      "/etc/nsswitch.conf",
      "~/.local/share/agent-memory",
      "/tmp/utilities-cryptsetup.*/.local/share/agent-memory"
    ],
    "allowWrite": [
      ".",
      "/tmp",
      "~/.claude",
      "~/.claude.json",
      "~/.copilot"
    ],
    "denyWrite": [
      "**/.edgerc",
      "**/.env*"
    ]
  }
}

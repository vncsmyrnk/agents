{
  "permissions": {
    "defaultMode": "acceptEdits",
    "additionalDirectories": [
      "~/.local/share/agent-memory",
      "~/workspace",
      "/tmp/utilities-cryptsetup.*/.local/share/agent-memory"
    ],
    "denyRead": [
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Edit(~/workspace/**/.git/**)",
      "Edit(~/workspace/**/.envrc)"
    ],
    "allow": [
      "mcp__github",
      "mcp__context7",
      "mcp__gcloud-observability",
      "mcp__gopls",
      "Edit(~/.local/share/agent-memory/**)",
      "Edit(//tmp/utilities-cryptsetup.*/.local/share/agent-memory/**)"
    ],
    "ask": [
      "mcp__github__add_comment_to_pending_review",
      "mcp__github__add_issue_comment",
      "mcp__github__add_reply_to_pull_request_comment",
      "mcp__github__assign_copilot_to_issue",
      "mcp__github__create_branch",
      "mcp__github__create_or_update_file",
      "mcp__github__create_pull_request",
      "mcp__github__create_pull_request_with_copilot",
      "mcp__github__create_repository",
      "mcp__github__delete_file",
      "mcp__github__delete_repository",
      "mcp__github__fork_repository",
      "mcp__github__issue_write",
      "mcp__github__merge_pull_request",
      "mcp__github__pull_request_review_write",
      "mcp__github__push_files",
      "mcp__github__request_copilot_review",
      "mcp__github__sub_issue_write",
      "mcp__github__update_issue_comment",
      "mcp__github__update_pull_request",
      "mcp__github__update_pull_request_branch"
    ]
  },
  "model": "opus[1m]",
  "enabledPlugins": {
    "superpowers@superpowers-marketplace": true,
    "context7@context7-marketplace": true,
    "gopls-lsp@claude-plugins-official": true,
    "frontend-design@claude-plugins-official": true,
    "figma@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {
    "superpowers-marketplace": {
      "source": {
        "source": "github",
        "repo": "obra/superpowers-marketplace"
      }
    },
    "context7-marketplace": {
      "source": {
        "source": "github",
        "repo": "upstash/context7"
      }
    }
  },
  "idleCompaction": false,
  "sandbox": {
    "enabled": true,
    "allowUnsandboxedCommands": false,
    "autoAllowBashIfSandboxed": true,
    "network": {
      "allowedDomains": [
        "*.anthropic.com",
        "*.claude.com",
        "*.githubcopilot.com",
        "*.github.com",
        "*.githubusercontent.com",
        "*.sscdn.co",
        "registry.npmjs.org",
        "stackoverflow.com",
        "go.dev",
        "*.golang.org",
        "github.com",
        "mcp.context7.com",
        "mcp.figma.com",
        "direnv.net",
        "www.gnu.org",
        "just.systems",
        "taskfile.dev",
        "docs.deno.com",
        "www.nushell.sh",
        "doc.rust-lang.org",
        "docs.rs",
        "elv.sh",
        "pkg.go.dev",
        "toml.io",
        "mariadb.com",
        "*.mariadb.org",
        "galeracluster.com",
        "*.googleapis.com"
      ]
    },
    "filesystem": {
      "denyRead": [
        "/tmp/utilities-cryptsetup*",
        "/home",
        "/etc",
        "**/.edgerc",
        "**/.env",
        "**/.env.*",
        "**/*.pem",
        "**/*.key",
        "/tmp/utilities-cryptsetup.*/.claude/.credentials.json",
        "/tmp/utilities-cryptsetup.*/.claude/sessions",
        "/tmp/claude-srt-unattended*",
        "/var/run/docker.sock",
        "/run/docker.sock",
        "/run/user/1000/bus",
        "/run/user/1000/keyring",
        "/run/user/1000/gnupg",
        "/run/user/1000/gcr"
      ],
      "allowRead": [
        "/etc/ssl",
        "/etc/ca-certificates",
        "/etc/pki",
        "/etc/hosts",
        "/etc/resolv.conf",
        "/etc/nsswitch.conf",
        "~/.local/share/agent-memory",
        "/tmp/utilities-cryptsetup.*/.local/share/agent-memory",
        "/tmp/utilities-cryptsetup.*/.claude"
      ],
      "denyWrite": [
        "/tmp/utilities-cryptsetup*",
        "~/dotfiles/agents",
        "~/workspace/**/.git/hooks",
        "~/workspace/**/.git/config",
        "~/workspace/**/.envrc",
        "~/workspace/**/.vscode"
      ],
      "allowWrite": [
        "/tmp",
        "~/.claude",
        "~/.local/share/agent-memory",
        "~/workspace",
        "/tmp/utilities-cryptsetup.*/.local/share/agent-memory",
        "/tmp/utilities-cryptsetup.*/.claude"
      ]
    }
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "mcp__.*",
        "hooks": [
          {
            "type": "command",
            "command": "sh ~/.claude/hooks/mcp-ask-unlisted.sh"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "sh ~/.claude/hooks/bash-ask-network.sh"
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "paplay /usr/share/sounds/freedesktop/stereo/dialog-information.oga"
          }
        ]
      }
    ]
  },
  "effortLevel": "medium",
  "statusLine": {
    "type": "command",
    "command": "bash ~/.claude/statusline-command.sh"
  }
}

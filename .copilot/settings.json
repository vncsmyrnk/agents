{
  "enabledPlugins": {
    "superpowers@superpowers-marketplace": true,
    "context7@context7-marketplace": true
  },
  "extraKnownMarketplaces": {
    "superpowers-marketplace": {
      "source": {
        "source": "github",
        "repo": "obra/superpowers-marketplace"
      }
    },
    "context7-marketplace": {
      "source": {
        "source": "github",
        "repo": "upstash/context7"
      }
    }
  },
  "sandbox": {
    "enabled": true,
    "sandboxMcpServers": false,
    "sandboxLspServers": false,
    "allowBypass": true,
    "userPolicy": {
      "filesystem": {
        "deniedPaths": [
          "~/.gnupg/**",
          "~/.ssh/**",
          "~/.config/**",
          "**/.env*"
        ]
      }
    }
  },
  "footer": {
    "showSandbox": true
  },
  "allowedUrls": [
    "https://direnv.net",
    "https://www.gnu.org",
    "https://just.systems",
    "https://taskfile.dev",
    "https://docs.deno.com",
    "https://www.nushell.sh",
    "https://doc.rust-lang.org",
    "https://docs.rs",
    "https://elv.sh",
    "https://pkg.go.dev",
    "https://toml.io"
  ]
}

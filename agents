#!/usr/bin/env bash
set -euo pipefail

usage() {
  echo "a simple agentic coding setup."
  echo
  echo "Commands:"
  echo "  claude"
}

cmd_claude() {
  exec claude --mcp-config "/home/vncsmyrnk/.claude/default.mcp.json" "$@"
}

case "${1:-}" in
claude)
  shift
  cmd_claude "$@"
  ;;
*)
  usage >&2
  exit 1
  ;;
esac
